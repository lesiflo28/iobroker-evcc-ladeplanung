     "icon": "mdi:map-search-outline",
     "htmlContent": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css\">\n<style>\n  html, body { margin: 0; padding: 0; height: 100%; background: #1f2937; }\n  #map { position: absolute; inset: 0; border-radius: 8px; }\n  #hint { position: absolute; left: 8px; bottom: 8px; z-index: 500; background: rgba(17,24,39,.85); color: #e5e7eb;\n          font: 12px/1.3 system-ui, sans-serif; padding: 4px 8px; border-radius: 6px; pointer-events: none; }\n  .lp-btn { display: block; margin-top: 6px; width: 100%; padding: 6px 8px; border: 0; border-radius: 6px; color: #fff;\n            font: 600 13px system-ui, sans-serif; cursor: pointer; }\n  .lp-ziel { background: #3b82f6; }\n  .lp-start { background: #16a34a; }\n  .lp-pop { font: 13px/1.35 system-ui, sans-serif; min-width: 170px; }\n  .leaflet-popup-content-wrapper, .leaflet-popup-tip { background: #1f2937; color: #fff; }\n  .leaflet-container a.leaflet-popup-close-button { color: #9ca3af; }\n</style>\n<div id=\"map\"></div>\n<div id=\"hint\">Tippen = Start oder Ziel wählen</div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js\"></script>\n<script>\n(function () {\n  var P = '0_userdata.0.Ladeplanung.';                 // Datenpunkt-Ordner (= CFG.BASE im Skript)\n  var api = window.aura;\n  var home = null, start = null, ziel = null, route = [], startIsHome = true;\n\n  function v(a, b) {\n    var s = (b !== undefined) ? b : a;\n    return (s && typeof s === 'object' && 'val' in s) ? s.val : s;\n  }\n  function pt(la, lo) { la = Number(la) || 0; lo = Number(lo) || 0; return (la && lo) ? [la, lo] : null; }\n\n  var map = L.map('map', { zoomControl: true, attributionControl: true }).setView([51.1657, 10.4515], 6);\n  // gleiche Kachelquelle wie das Aura-Karten-Widget (OpenStreetMap, ohne API-Key)\n  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {\n    maxZoom: 19, attribution: '&copy; OpenStreetMap'\n  }).addTo(map);\n\n  function dot(color, size) {\n    return L.divIcon({ className: '', iconSize: [size, size], iconAnchor: [size / 2, size / 2],\n      html: '<div style=\"width:' + size + 'px;height:' + size + 'px;border-radius:50%;background:' + color +\n            ';border:3px solid #fff;box-shadow:0 0 4px rgba(0,0,0,.6)\"></div>' });\n  }\n\n  var layers = [], pickMarker = null;\n  function draw() {\n    layers.forEach(function (l) { map.removeLayer(l); });\n    layers = [];\n    var s = start || home;\n    if (home && !startIsHome) layers.push(L.marker(home, { icon: dot('#9ca3af', 12) }).bindTooltip('Zuhause'));\n    if (route && route.length > 1) layers.push(L.polyline(route, { color: '#3b82f6', weight: 5, opacity: .85 }));\n    if (s) layers.push(L.marker(s, { icon: dot('#22c55e', 16) }).bindTooltip(startIsHome ? 'Start: Zuhause' : 'Start'));\n    if (ziel) layers.push(L.marker(ziel, { icon: dot('#ef4444', 18) }).bindTooltip('Ziel'));\n    layers.forEach(function (l) { l.addTo(map); });\n    var pts = [s, ziel].filter(Boolean);\n    if (route && route.length > 1) map.fitBounds(L.latLngBounds(route), { padding: [24, 24] });\n    else if (pts.length === 2) map.fitBounds(L.latLngBounds(pts), { padding: [24, 24] });\n    else if (pts.length === 1) map.setView(pts[0], 10);\n  }\n\n  function button(cls, text, dp, value) {\n    var b = document.createElement('button');\n    b.className = 'lp-btn ' + cls;\n    b.textContent = text;\n    b.onclick = function () {\n      b.disabled = true; b.textContent = 'Route wird berechnet …';\n      api.setState(P + dp, value).then(function () {\n        map.closePopup();\n        if (pickMarker) { map.removeLayer(pickMarker); pickMarker = null; }\n      }).catch(function (err) { b.textContent = 'Fehler: ' + err; });\n    };\n    return b;\n  }\n\n  map.on('click', function (e) {\n    var c = e.latlng.lat.toFixed(5) + ', ' + e.latlng.lng.toFixed(5);\n    if (pickMarker) map.removeLayer(pickMarker);\n    pickMarker = L.marker(e.latlng, { icon: dot('#eab308', 16) }).addTo(map);\n    var box = document.createElement('div');\n    box.className = 'lp-pop';\n    box.innerHTML = '<span style=\"color:#9ca3af\">' + c + '</span>';\n    box.appendChild(button('lp-ziel', 'Als Ziel übernehmen', 'Zielort', c));\n    box.appendChild(button('lp-start', 'Als Start übernehmen', 'Startort', c));\n    pickMarker.bindPopup(box, { closeButton: true }).openPopup();\n    pickMarker.on('popupclose', function () {\n      if (pickMarker) { map.removeLayer(pickMarker); pickMarker = null; }\n    });\n  });\n\n  if (!api) { document.getElementById('hint').textContent = 'aura-API fehlt (htmlApi aus?)'; return; }\n\n  var ids = ['Home_Lat', 'Home_Lon', 'Start_Lat', 'Start_Lon', 'Ziel_Lat', 'Ziel_Lon', 'Route_JSON', 'Startort'];\n  var cur = {};\n  function apply() {\n    home = pt(cur.Home_Lat, cur.Home_Lon);\n    startIsHome = !String(cur.Startort || '').trim();\n    start = startIsHome ? home : pt(cur.Start_Lat, cur.Start_Lon);\n    ziel = pt(cur.Ziel_Lat, cur.Ziel_Lon);\n    try { route = JSON.parse(cur.Route_JSON || '[]'); } catch (e) { route = []; }\n    draw();\n  }\n  var t = null;\n  function later() { clearTimeout(t); t = setTimeout(apply, 300); }\n\n  Promise.all(ids.map(function (id) { return api.getState(P + id); })).then(function (r) {\n    ids.forEach(function (id, i) { cur[id] = v(r[i]); });\n    apply();\n  }).catch(function () {});\n  ids.forEach(function (id) {\n    api.subscribe(P + id, function (a, b) { cur[id] = v(a, b); later(); });\n  });\n})();\n</script>\n",
